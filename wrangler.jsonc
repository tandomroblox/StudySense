
{
  "main": "./src/index.js",
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "studysense",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studysense-db",
      "database_id": "c9659d3e-deef-4c76-9d87-6f06500982d9"
    }
  ]
}
