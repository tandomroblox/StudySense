
{
  "main": "./src/index.js",
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "studysense",
  "compatibility_date": "2026-10-27",
  "vars": {
    "GOOGLE_CLIENT_ID": "162780986933-ojjeqgh3vom75n63i8p9e9c4bog1sfkt.apps.googleusercontent.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studysense-db",
      "database_id": "c9659d3e-deef-4c76-9d87-6f06500982d9"
    }
  ]
}
