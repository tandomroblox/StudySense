{
  "manifest_version": 3,
  "name": "StudySense Time Guard",
  "version": "1.1.0",
  "description": "Private, local website-time reports with optional 15-minute restricted-site allowance and 35-minute cooldown.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StudySense Time Guard",
    "default_popup": "popup.html"
  }
}