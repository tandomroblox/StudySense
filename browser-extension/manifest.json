{
  "manifest_version": 3,
  "name": "StudySense Time Guard",
  "version": "1.2.0",
  "description": "Automatically tracks common entertainment sites locally, with a 15-minute combined allowance, break popup, and 35-minute cooldown.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StudySense Time Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
