{
  "manifest_version": 3,
  "name": "StudySense Time Guard",
  "version": "1.3.0",
  "description": "Tracks local browser usage and can show its connection status on the StudySense Time Guard website.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://studysense.studysenseapp.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studysense.studysenseapp.workers.dev/*"
      ],
      "js": [
        "website-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "StudySense Time Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
